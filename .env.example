# Public URL of the deployed site (used for sitemap, robots and Open Graph URLs)
NEXT_PUBLIC_SITE_URL=https://example.org

# Optional: endpoint that accepts POSTed JSON enquiries (e.g. Formspree, a serverless function).
# When unset, the enquiry form runs in clearly-labelled demo mode and sends nothing.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
